# ============================================
# APPLICATION
# ============================================
# Node environment: development | production | testing
NODE_ENV=development

# Server port
PORT=3000

# API URL prefix (default: api)
API_PREFIX=api

# Comma-separated list of allowed CORS origins (default: http://localhost:4200,http://localhost:3000)
# In production, MUST specify explicit origins - wildcards are rejected
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Whether to send CORS credentials (cookies, auth headers)
CORS_CREDENTIALS=true

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://tablofy:tablofy_dev@localhost:5432/tablofy_dev?schema=public"

# ============================================
# REDIS
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Optional: password for Redis authentication
# REDIS_PASSWORD=
# Optional: enable TLS for Redis (true/false)
# REDIS_TLS=false

# ============================================
# JWT (minimum 32 characters each)
# ============================================
# Secret used to sign access tokens (min 32 chars, use a strong random value in production)
JWT_SECRET="change-this-to-a-strong-random-secret-at-least-32-chars-long"
# Access token expiry (e.g. 15m, 1h, 1d)
JWT_EXPIRATION=15m
# Secret used to sign refresh tokens (min 32 chars, different from JWT_SECRET)
JWT_REFRESH_SECRET="change-this-to-another-strong-random-secret"
# Refresh token expiry (e.g. 7d, 30d)
JWT_REFRESH_EXPIRATION=7d

# ============================================
# RATE LIMITING (global NestJS throttler)
# ============================================
# Time window in seconds (default: 60)
THROTTLE_TTL=60
# Maximum requests per time window (default: 120)
THROTTLE_LIMIT=120

# ============================================
# CLEANUP & RETENTION (optional)
# ============================================
# Number of days to retain expired sessions before cleanup (default: 30)
# CLEANUP_SESSION_RETENTION_DAYS=30
# Number of days to retain expired verification tokens (default: 7)
# CLEANUP_TOKEN_RETENTION_DAYS=7
# Number of days to retain audit logs before archival (default: 365)
# AUDIT_LOG_RETENTION_DAYS=365
