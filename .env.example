# ============================================
# APPLICATION
# ============================================

NODE_ENV=development
PORT=3000
API_PREFIX=api

# Graceful shutdown timeout in ms (forced exit if app.close() exceeds this)
# SHUTDOWN_TIMEOUT_MS=15000

# Number of reverse-proxy hops to trust for the client IP (X-Forwarded-For).
# REQUIRED behind nginx / ALB / Cloudflare, otherwise every user shares one
# per-IP rate-limit bucket. Use 1 for a single proxy in front of the API.
# TRUST_PROXY=1

# Absolute RSS ceiling (MB) for the /health and /health/ready memory indicator.
# Must be sized to the container memory limit. Too low and healthy instances are
# pulled out of the load balancer during normal traffic peaks.
# HEALTH_MEMORY_RSS_LIMIT_MB=300

# OpenAPI/Swagger UI at /docs and /docs-json. The document lists every endpoint,
# DTO and business concept, so production keeps it OFF unless you opt in.
# When SWAGGER_ENABLED=true in production, SWAGGER_AUTH_USER and
# SWAGGER_AUTH_PASSWORD become REQUIRED and /docs is protected by HTTP Basic
# auth. The app refuses to boot otherwise.
# SWAGGER_ENABLED=true
# SWAGGER_AUTH_USER=
# SWAGGER_AUTH_PASSWORD=

# Compress JSON/text responses larger than the threshold. Disable when a CDN or
# reverse proxy already compresses responses.
# COMPRESSION_ENABLED=true
# COMPRESSION_THRESHOLD_BYTES=1024

CORS_ORIGINS=http://localhost:4200,http://localhost:3000
CORS_CREDENTIALS=true

# Frontend base URL used to build password-reset / email-verification links
FRONTEND_URL=http://localhost:4200


# ============================================
# DATABASE
# ============================================

# PostgreSQL connection string
# Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# NOTE: the verified runtime database is "tablofy_prod" (see docker-compose).
# Destructive Prisma scripts (prisma:reset) are guarded by prisma/scripts/
# assert-safe-db.js and refuse to run against production-like databases.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"


# ============================================
# REDIS
# ============================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Redis auth is MANDATORY in production: docker-compose.prod.yml and env validation
# require a non-empty REDIS_PASSWORD (min 16 characters). The dev docker-compose.yml
# ships a strong dev-only default; override it here (and in docker/.env) to match.
# REDIS_PASSWORD=
# REDIS_USERNAME=
# REDIS_DB=0
# REDIS_TLS=false
# REDIS_CONNECT_TIMEOUT=

# ---- Redis high availability ----
# REDIS_MODE auto-detects from the variables below and defaults to "standalone":
#   set REDIS_CLUSTER_NODES -> cluster, REDIS_SENTINEL_HOSTS/MASTER -> sentinel.
# Set it explicitly to override detection.
# Cluster mode needs startup nodes only; ioredis discovers the rest of the
# topology from the cluster. A misconfigured topology cannot be auto-detected as
# broken (ioredis retries silently), so production startup warns about it.
# REDIS_MODE=cluster
# REDIS_CLUSTER_NODES=10.0.0.1:6379,10.0.0.2:6379,10.0.0.3:6379
# REDIS_CLUSTER_SCALE_READS=master

# Sentinel mode needs the sentinel addresses and the master set name, e.g. "mymaster".
# REDIS_MODE=sentinel
# REDIS_SENTINEL_HOSTS=10.0.0.1:26379,10.0.0.2:26379,10.0.0.3:26379
# REDIS_SENTINEL_MASTER=tablofy-master
# REDIS_SENTINEL_PASSWORD=
# REDIS_SENTINEL_ROLE=master


# ============================================
# JWT
# ============================================

JWT_SECRET="your-minimum-32-character-secret-here"
JWT_EXPIRATION=15m

JWT_REFRESH_SECRET="your-different-refresh-secret-here"
JWT_REFRESH_EXPIRATION=7d


# ============================================
# RATE LIMITING
# ============================================

THROTTLE_TTL=60
THROTTLE_LIMIT=120

# Plan-based throttling. The global throttle above applies per IP; these limits
# apply per tenant and are looked up from the tenant's subscription plan.
# THROTTLE_PLAN_WINDOW_SECONDS=60
# THROTTLE_PLAN_FREE=30
# THROTTLE_PLAN_BASIC=60
# THROTTLE_PLAN_STANDARD=120
# THROTTLE_PLAN_PREMIUM=300
# THROTTLE_PLAN_ENTERPRISE=1000

# Unauthenticated (pre-login) requests share one budget per IP address.
# THROTTLE_UNAUTHENTICATED_LIMIT=100

# Per-API-key throttling. Requests sent with "Authorization: ApiKey <key>" get
# their own budget on top of the tenant bucket, so one noisy integration cannot
# exhaust the whole tenant allowance. Only a truncated SHA-256 of the key is
# used as the bucket identity; the raw key is never stored.
# THROTTLE_API_KEY_ENABLED=true
# THROTTLE_API_KEY_LIMIT=600
# THROTTLE_API_KEY_WINDOW_SECONDS=60


# ============================================
# OBSERVABILITY
# ============================================

# Sentry error tracking (https://sentry.io). Optional; disabled unless SENTRY_ENABLED=true AND SENTRY_DSN is set.
# SENTRY_ENABLED=false
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Prometheus metrics. /metrics is exposed without auth in non-production only.
# Production REQUIRES METRICS_AUTH_TOKEN (min 16 chars) when metrics are enabled.
# METRICS_ENABLED=true
# METRICS_ENDPOINT=metrics
# METRICS_AUTH_TOKEN=
# METRICS_COLLECT_DEFAULT=true
# METRICS_COLLECT_INTERVAL_MS=10000

# OpenTelemetry distributed tracing + OTLP metrics. Optional and disabled by
# default; it stays OFF unless OTEL_ENABLED=true AND OTEL_EXPORTER_OTLP_ENDPOINT
# is set, because an SDK with no collector would silently drop every span.
# The endpoint is the collector base URL; "/v1/traces" and "/v1/metrics" are
# appended automatically, so do not include them here.
# Auto-instruments HTTP, Prisma/pg, ioredis and BullMQ. Filesystem spans are off.
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=tablofy-api
# OTEL_TRACES_ENABLED=true
# OTEL_METRICS_ENABLED=true
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# OTEL_METRIC_EXPORT_INTERVAL=60000

# Health check tuning
# HEALTH_DISK_PATH=/
# HEALTH_DISK_THRESHOLD_MB=200

# Dead letter queue alert threshold (depth that triggers an error log)
# QUEUE_DLQ_ALERT_THRESHOLD=50
# ============================================
# PAYMENTS (Stripe + Paymob)
# ============================================

# Payment gateway mode.
#   mock — returns fake gateway data. FORBIDDEN in production (bootstrap fails).
#   test — calls the real Stripe API with Stripe TEST keys (STRIPE_SECRET_KEY must
#          start with sk_test_). FORBIDDEN in production. Webhook events still need
#          a live-mode webhook route; STRIPE_WEBHOOK_SECRET must be the test webhook secret.
#   live — real gateway credentials required. Stripe keys must be sk_live_* and
#          Stripe requires STRIPE_WEBHOOK_SECRET; Paymob requires a positive
#          PAYMOB_INTEGRATION_ID and PAYMOB_WEBHOOK_SECRET. The app refuses to
#          boot if a configured live gateway is missing its webhook secret.
# When unset: development/test default to "mock", production defaults to "live".
# PAYMENTS_MODE=mock

# Stripe (used for CREDIT_CARD / DEBIT_CARD methods)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE=https://api.stripe.com

# Paymob (used for MOBILE_PAYMENT method)
# PAYMOB_API_KEY=
# PAYMOB_INTEGRATION_ID=
# PAYMOB_API_BASE=https://accept.paymob.com/api
# PAYMOB_WEBHOOK_SECRET=


# ============================================
# WEBHOOKS
# ============================================

# REQUIRED. Used to encrypt tenant webhook signing secrets at rest (AES-256-GCM).
# The application refuses to boot without it (min 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WEBHOOK_ENCRYPTION_KEY=

# Webhook delivery tuning
# WEBHOOK_MAX_RETRIES=5
# WEBHOOK_INITIAL_BACKOFF_MS=1000
# WEBHOOK_BACKOFF_FACTOR=2
# WEBHOOK_MAX_BACKOFF_MS=3600000
# WEBHOOK_DELIVERY_TIMEOUT_MS=30000
# WEBHOOK_MAX_REGISTRATIONS_PER_TENANT=50
# WEBHOOK_SECRET_ROTATION_DAYS=90


# ============================================
# EMAIL (SMTP)
# ============================================

# When SMTP_HOST is set, email jobs (password reset, email verification,
# scheduled report delivery) are delivered through this SMTP server. When unset,
# email jobs fail loudly, are retried, and dead-letter instead of being silently
# dropped. Production REQUIRES SMTP_HOST and SMTP_FROM; the app refuses to boot
# otherwise.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# EXPORTS
# ============================================

# Directory where generated export/report files are stored and read back from
# when emailed as attachments. Relative paths resolve against the app working
# directory. Defaults to <cwd>/exports.
# EXPORT_DIR=./exports

# Retention (in days) for completed scheduled-report export files. Exports
# older than this are purged nightly by the cleanup job (file + database row).
# Defaults to 30.
# REPORT_EXPORT_RETENTION_DAYS=30


# ============================================
# SSO (OIDC + SAML 2.0)
# ============================================

# Enable tenant single sign-on. When true, SSO_ENCRYPTION_KEY (or
# WEBHOOK_ENCRYPTION_KEY) and SSO_CALLBACK_BASE_URL (or FRONTEND_URL for the
# redirect) are required at boot.
# SSO_ENABLED=false

# Encrypts tenant IdP client secrets at rest (AES-256-GCM). Falls back to
# WEBHOOK_ENCRYPTION_KEY. Min 32 characters.
# SSO_ENCRYPTION_KEY=

# Public base URL of THIS API, including the global prefix. Used to build the
# OIDC redirect_uri and the SAML ACS URL. Register at the IdP:
#   OIDC -> <SSO_CALLBACK_BASE_URL>/auth/sso/callback
#   SAML -> <SSO_CALLBACK_BASE_URL>/auth/sso/saml/acs
# SAML connections also store idpEntityId, idpSsoUrl and idpCertificate; the SP
# metadata XML is served at GET /auth/sso/:id/saml/metadata.
# SSO_CALLBACK_BASE_URL=https://api.example.com/api/v1

# Where the browser is sent after a successful/failed login. The success URL
# receives ?code=<one-time-code>, exchanged at POST /auth/sso/exchange.
# SSO_SUCCESS_REDIRECT_URL=https://app.example.com/sso/callback
# SSO_FAILURE_REDIRECT_URL=https://app.example.com/login

# Lifetime of the OIDC state/nonce (seconds) and of the one-time exchange code.
# SSO_STATE_TTL_SECONDS=600
# SSO_EXCHANGE_CODE_TTL_SECONDS=60


# ============================================
# File uploads (product images)
# ============================================

# Directory where uploaded product images are written. In a multi-instance
# deployment this MUST be a shared volume (or object storage) so every replica
# can serve the URL it returns. Defaults to <cwd>/uploads.
# UPLOAD_DIR=./uploads

# Public base URL prepended to stored image URLs. Leave empty to serve files
# from this API at /uploads/... and return a root-relative URL.
# UPLOAD_PUBLIC_BASE_URL=https://cdn.example.com

# Maximum accepted image size in bytes. Defaults to 5242880 (5 MB).
# UPLOAD_MAX_IMAGE_SIZE_BYTES=5242880


# ============================================
# External dependency health checks (GET /health/dependencies)
# ============================================

# Optional SMS gateway health endpoint. When unset, SMS is reported as
# configured=false (up); no SMS sending is wired yet.
# SMS_PROVIDER_URL=https://sms.example.com/health
# SMS_API_KEY=

# Timeout (ms) for each outbound email/SMS/payment probe. Defaults to 5000.
# HEALTH_DEPENDENCY_TIMEOUT_MS=5000

