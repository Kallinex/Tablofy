model InventoryItem {
  id                String    @id @default(uuid())
  tenantId          String
  name              String
  description       String?
  sku               String?
  barcode           String?
  internalCode      String?
  categoryId        String?
  unitId            String?
  locationId        String?
  currentQuantity   Decimal   @default(0) @db.Decimal(12, 4)
  reservedQuantity  Decimal   @default(0) @db.Decimal(12, 4)
  availableQuantity Decimal   @default(0) @db.Decimal(12, 4)
  minStock          Decimal?  @db.Decimal(12, 4)
  maxStock          Decimal?  @db.Decimal(12, 4)
  reorderLevel      Decimal?  @db.Decimal(12, 4)
  unitCost          Decimal?  @db.Decimal(12, 4)
  averageCost       Decimal?  @db.Decimal(12, 4)
  lastCost          Decimal?  @db.Decimal(12, 4)
  isActive          Boolean   @default(true)
  isPurchasable     Boolean   @default(true)
  isManufactured    Boolean   @default(false)
  image             String?
  metadata          Json?
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  category           InventoryCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unit               InventoryUnit?       @relation(fields: [unitId], references: [id], onDelete: SetNull)
  location           InventoryLocation?   @relation(fields: [locationId], references: [id], onDelete: SetNull)
  batches            InventoryBatch[]
  movements          StockMovement[]
  adjustments        StockAdjustment[]
  waste              WasteEntry[]
  counts             InventoryCount[]
  alerts             ExpirationAlert[]
  poItems            PurchaseOrderItem[]
  grItems            GoodsReceiptItem[]
  transferItems      BranchTransferItem[]
  recipeItems        RecipeItem[]
  ingredients        Ingredient[]
  forecasts          InventoryForecast[]
  reorderSuggestions ReorderSuggestion[]
  consumptionRecords ConsumptionRecord[]
  barcodes           Barcode[]
  valuations         InventoryValuation[]
  cycleCountItems    CycleCountItem[]

  @@unique([tenantId, sku, deletedAt])
  @@index([barcode])
  @@index([categoryId])
  @@index([deletedAt])
  @@index([isActive])
  @@index([locationId])
  @@index([sku])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([unitId])
  @@map("inventory_items")
}

