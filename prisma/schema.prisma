  tenantId  String
  userId    String?
  rating    Int
  comment   String?
  source    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([rating])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([userId])
  @@map("feedback")
}

model TaxRate {
