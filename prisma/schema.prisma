  name         String
  rate         Decimal   @db.Decimal(5, 4)
  isPercentage Boolean   @default(true)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  orders     Order[]    @relation("OrderServiceCharge")
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, name, deletedAt])
  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("service_charges")
}

model Unit {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  abbreviation String
  type         UnitType
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([tenantId, name, deletedAt])
  @@index([deletedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("units")
}

model Campaign {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  description String?
  type        CampaignType
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  budget      Decimal?       @db.Decimal(10, 2)
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  templates  CampaignTemplate[]
  recipients CampaignRecipient[]
  analytics  CampaignAnalytics?
  approval   CampaignApproval?

  @@index([deletedAt])
  @@index([endsAt])
  @@index([startsAt])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([type])
  @@map("campaigns")
}

// ============================================
// KDS — Kitchen Display System (Phase 3 M2)
// ============================================

model KitchenStation {
  id           String    @id @default(uuid())
  tenantId     String
  restaurantId String
  name         String
  slug         String
  description  String?
  color        String?
  icon         String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant  Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products    Product[]
  tickets     KitchenTicket[]
  ticketItems KitchenTicketItem[]

  @@unique([restaurantId, name])
  @@unique([restaurantId, slug])
  @@index([displayOrder])
  @@index([isActive])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("kitchen_stations")
}

model KitchenTicketItem {
  id          String           @id @default(uuid())
  ticketId    String
  orderItemId String
  tenantId    String
  stationId   String?
  status      TicketItemStatus @default(PENDING)
  startedAt   DateTime?
  completedAt DateTime?
  notes       String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime         @updatedAt

  ticket    KitchenTicket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  station   KitchenStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([startedAt])
  @@index([stationId])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([ticketId])
  @@map("kitchen_ticket_items")
}

// ============================================
// ENUMS (Phase 4 M1 — 8 new)
// ============================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum RewardType {
  COUPON
  DISCOUNT
  FREE_PRODUCT
  FREE_DRINK
  BIRTHDAY
  ANNIVERSARY
  REFERRAL
  PROMOTIONAL
}

enum RewardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum WalletTransactionType {
  RECHARGE
  SPEND
  REFUND
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum ReferralStatus {
  PENDING
  REWARDED
  EXPIRED
}

enum SegmentType {
  VIP
  INACTIVE
  HIGH_SPENDER
  FREQUENT_VISITOR
  NEW_CUSTOMER
  LOST_CUSTOMER
  CUSTOM
}

// ============================================
// MODELS (Phase 4 M1 — 17 new)
// ============================================

model Customer {
  id                String         @id @default(uuid())
  tenantId          String
  restaurantId      String?
  email             String?
  phone             String?
  firstName         String
  lastName          String
  avatarUrl         String?
  gender            String?
  dateOfBirth       DateTime?
  anniversary       DateTime?
  language          String         @default("en")
  notes             String?
  status            CustomerStatus @default(ACTIVE)
  preferredBranchId String?
  preferredTableId  String?
  tags              String[]
  source            String?
  metadata          Json?
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  tenant              Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  restaurant          Restaurant?                 @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  addresses           CustomerAddress[]
  preferences         CustomerPreference[]
  visitHistory        VisitHistory[]
  loyaltyTransactions LoyaltyPointsTransaction[]
  memberships         Membership[]
  rewards             Reward[]
  wallets             Wallet[]
  referralsMade       Referral[]                  @relation("ReferralMade")
  referralsUsed       Referral[]                  @relation("ReferralUsed")
  segmentAssignments  CustomerSegmentAssignment[]
  analytics           CustomerAnalytics?
  timelineEntries     CrmTimelineEntry[]
  communicationLogs   CommunicationLog[]
  campaignRecipients  CampaignRecipient[]
  promotionUsages     PromotionUsage[]
  membershipHistory   MembershipHistory[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("customers")
}

model CustomerAddress {
  id         String    @id @default(uuid())
  customerId String
  tenantId   String
  label      String?
  address    String
  city       String?
  state      String?
  zipCode    String?
  country    String?
  isDefault  Boolean   @default(false)
  latitude   Float?
  longitude  Float?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("customer_addresses")
}

model CustomerPreference {
  id         String    @id @default(uuid())
  customerId String
  tenantId   String
  key        String
  value      String
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("customer_preferences")
}

model VisitHistory {
  id           String    @id @default(uuid())
  customerId   String
  tenantId     String
  restaurantId String?
  branchId     String?
  orderId      String?
  visitedAt  DateTime   @default(now())
  totalSpent Decimal?   @db.Decimal(10, 2) @default(0)
  itemsCount   Int?      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, visitedAt])
  @@index([customerId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([visitedAt])
  @@map("visit_history")
}

model LoyaltyProgram {
  id                 String    @id @default(uuid())
  tenantId           String    @unique
  pointsPerCurrency  Decimal   @default(10)
  currencyPerPoint   Decimal   @default(0.1)
  minPointsRedeem    Int       @default(100)
  maxPointsRedeem    Int?
  pointsExpireDays   Int       @default(365)
  earnEnabled        Boolean   @default(true)
  redeemEnabled      Boolean   @default(true)
  welcomeBonusPoints Int       @default(0)
  referrerPoints     Int       @default(50)
  referredPoints     Int       @default(25)
  birthdayPoints     Int       @default(100)
  anniversaryPoints  Int       @default(50)
  createdAt          DateTime  @default(now())
  deletedAt          DateTime?
  updatedAt          DateTime  @updatedAt

  tiers LoyaltyTier[]

  @@index([tenantId, createdAt])
  @@map("loyalty_programs")
}

model LoyaltyTier {
  id                String         @id @default(uuid())
  programId         String
  tenantId          String
  tier              MembershipTier
  minPoints         Int            @default(0)
  maxPoints         Int            @default(1000)
  multiplier        Decimal        @default(1)
  discountPercent   Decimal        @default(0)
  priorityService   Boolean        @default(false)
  freeDelivery      Boolean        @default(false)
  birthdayReward    Boolean        @default(true)
  anniversaryReward Boolean        @default(true)
  metadata          Json?
  createdAt         DateTime       @default(now())
  deletedAt         DateTime?
  updatedAt         DateTime       @updatedAt

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, tier])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("loyalty_tiers")
}

model LoyaltyPointsTransaction {
  id            String                 @id @default(uuid())
  customerId    String
  tenantId      String
  restaurantId  String?
  points        Int
  type          LoyaltyTransactionType
  description   String?
  referenceId   String?
  referenceType String?
  balanceAfter  Int
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
