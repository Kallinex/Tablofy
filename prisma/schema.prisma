  totalSpend         Decimal  @default(0)
  totalOrders        Int      @default(0)
  favoriteProductId  String?
  favoriteCategoryId String?
  favoriteProductName String?
  favoriteCategoryName String?
  lastVisitAt        DateTime?
  lastOrderAt        DateTime?
  rewardUsageCount   Int      @default(0)
  rewardPointsEarned Int      @default(0)
  rewardPointsRedeemed Int    @default(0)
  daysSinceLastVisit Int      @default(0)
  metadata           Json?
  computedAt         DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([lifetimeValue])
  @@index([totalVisits])
  @@map("customer_analytics")
}
