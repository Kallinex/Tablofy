  deletedAt    DateTime?
  updatedAt    DateTime              @updatedAt

  registration WebhookRegistration @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([nextRetryAt])
  @@index([status, nextRetryAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([webhookId])
  @@map("webhook_deliveries")
}

model ApiKey {
