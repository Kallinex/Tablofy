generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS (Phase 2A — 7 existing)
// ============================================

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
  KITCHEN
  CASHIER
  WAITER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum PlanType {
  FREE
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  PAUSED
}

enum Currency {
  USD
  EUR
  GBP
  EGP
  SAR
  AED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum VerificationType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ============================================
// ENUMS (Phase 2B M1 — 6 new)
// ============================================

enum TenantStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  SUSPENDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  OUT_OF_SERVICE
}

enum BranchType {
  MAIN
  BRANCH
  FRANCHISE
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  MOBILE_PAYMENT
  BANK_TRANSFER
  WALLET
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  IN_PREPARATION
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
  VOIDED
}

enum KitchenStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum TicketItemStatus {
  PENDING
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum NoteType {
  GENERAL
  KITCHEN
  CUSTOMER
  WAITER
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum VariantType {
  SINGLE
  MULTIPLE
}

enum UnitType {
  WEIGHT
  VOLUME
  COUNT
  LENGTH
}

// ============================================
// MODELS (Phase 2A — 8 existing)
// ============================================

model Tenant {
  id                 String       @id @default(uuid())
  name               String
  slug               String       @unique
  description        String?
  phone              String?
  email              String?
  address            String?
  city               String?
  country            String?
  timezone           String       @default("UTC")
  currency           Currency     @default(USD)
  locale             String       @default("en")
  logoUrl            String?
  metadata           Json?
  status             TenantStatus @default(ACTIVE)
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  dataRetentionUntil DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  users                User[]
  subscription         Subscription?
  invitations          Invitation[]
  auditLogs            AuditLog[]
  restaurants          Restaurant[]
  customers            Customer[]
  scheduledReports     ScheduledReport[]
  reportExports        ReportExport[]
  analyticsDashboards  AnalyticsDashboard[]
  webhookRegistrations WebhookRegistration[]
  apiKeys              ApiKey[]
  giftCards            GiftCard[]
  consentRecords       ConsentRecord[]
  cookiePreferences    CookiePreference[]
  dataExportRequests   DataExportRequest[]
  backupRecords        BackupRecord[]
  membershipHistory    MembershipHistory[]
  eventLogs            EventLog[]

  @@index([status])
  @@index([deletedAt])
  @@index([slug])
  @@map("tenants")
}

model User {
  id                  String     @id @default(uuid())
  tenantId            String?
  email               String
  password            String
  firstName           String
  lastName            String
  phone               String?
  role                UserRole   @default(STAFF)
  status              UserStatus @default(ACTIVE)
  avatarUrl           String?
  emailVerified       Boolean    @default(false)
  lastPasswordChange  DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecret     String?
  preferences         Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  tenant             Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  refreshTokens      RefreshToken[]
  sessions           Session[]
  invitedUsers       Invitation[]          @relation("InvitedBy")
  verificationTokens VerificationToken[]
  auditLogs          AuditLog[]
  orders             Order[]
  orderNotes         OrderNote[]
  statusChanges      OrderStatusHistory[]
  notifications      Notification[]
  sentMessages       Message[]             @relation("MessageSender")
  receivedMessages   Message[]             @relation("MessageRecipient")
  feedback           Feedback[]
  reports            Report[]
  apiKeys            ApiKey[]
  issuedGiftCards    GiftCard[]            @relation("IssuedGiftCards")
  performedTxns      GiftCardTransaction[] @relation("PerformedTransactions")
  consentRecords     ConsentRecord[]
  dataExportRequests DataExportRequest[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([lockedUntil])
  @@index([role])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Session {
  id           String    @id @default(uuid())
  userId       String
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Subscription {
  id           String             @id @default(uuid())
  tenantId     String             @unique
  plan         PlanType           @default(FREE)
  status       SubscriptionStatus @default(ACTIVE)
  startDate    DateTime           @default(now())
  endDate      DateTime?
  trialEndsAt  DateTime?
  maxUsers     Int                @default(5)
  maxProducts  Int                @default(100)
  maxTables    Int                @default(10)
  maxBranches  Int                @default(1)
  monthlyPrice Decimal            @default(0) @db.Decimal(10, 2)
  createdAt    DateTime           @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("subscriptions")
}

model Invitation {
  id         String           @id @default(uuid())
  tenantId   String
  email      String
  role       UserRole         @default(STAFF)
  token      String           @unique
  status     InvitationStatus @default(PENDING)
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime         @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inviter User   @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([token])
  @@map("invitations")
}

model VerificationToken {
  id        String           @id @default(uuid())
  userId    String
  token     String           @unique
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

model AuditLog {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  isArchived Boolean   @default(false)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt, isArchived])
  @@index([createdAt])
  @@index([isArchived])
  @@index([resource, resourceId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([userId])
  @@map("audit_logs")
}

// ============================================
// MODELS (Phase 2B M1 — Restaurant Core)
// ============================================

model Restaurant {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  phone       String?
  email       String?
  address     String?
  city        String?
  country     String?
  timezone    String    @default("UTC")
  currency    Currency  @default(USD)
  logoUrl     String?
  metadata    Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant            Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches          Branch[]
  floors            Floor[]
  menus             MenuCategory[]
  orders            Order[]
  Product           Product[]
  VariantGroup      VariantGroup[]
  ModifierGroup     ModifierGroup[]
  ProductTag        ProductTag[]
  Allergen          Allergen[]
  BusinessHours     BusinessHours[]
  BusinessException BusinessException[]
  TaxRate           TaxRate[]
  ServiceCharge     ServiceCharge[]
  KitchenStation    KitchenStation[]
  Customer          Customer[]

  @@unique([tenantId, slug])
  @@index([deletedAt])
  @@index([isActive])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("restaurants")
}

model Branch {
  id           String     @id @default(uuid())
  restaurantId String
  tenantId     String
  name         String
  slug         String
  type         BranchType @default(BRANCH)
  phone        String?
  email        String?
  address      String?
  city         String?
  country      String?
  latitude     Decimal?   @db.Decimal(10, 8)
  longitude    Decimal?   @db.Decimal(11, 8)
  timezone     String     @default("UTC")
  isActive     Boolean    @default(true)
  metadata     Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  restaurant         Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  floors             Floor[]
  areas              DiningArea[]
  tables             Table[]
  orders             Order[]
  inventoryLocations InventoryLocation[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  transfersFrom      BranchTransfer[]    @relation("TransferFromBranch")
  transfersTo        BranchTransfer[]    @relation("TransferToBranch")
  warehouseBranches  WarehouseBranch[]

  @@unique([restaurantId, slug])
  @@index([deletedAt])
  @@index([isActive])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("branches")
}

model Floor {
  id           String    @id @default(uuid())
  restaurantId String
  branchId     String
  tenantId     String
  name         String
  level        Int       @default(1)
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch     Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  areas      DiningArea[]

  @@index([branchId])
  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("floors")
}

model DiningArea {
  id        String    @id @default(uuid())
  branchId  String
  floorId   String
  tenantId  String
  name      String
  capacity  Int       @default(20)
  section   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor  Floor   @relation(fields: [floorId], references: [id], onDelete: Cascade)
  tables Table[]

  @@index([branchId])
  @@index([deletedAt])
  @@index([floorId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("dining_areas")
}

model Table {
  id           String      @id @default(uuid())
  branchId     String
  diningAreaId String
  tenantId     String
  number       String
  seats        Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  qrCode       String?     @unique
  isActive     Boolean     @default(true)
  metadata     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  diningArea DiningArea @relation(fields: [diningAreaId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([branchId, number])
  @@index([branchId])
  @@index([deletedAt])
  @@index([diningAreaId])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("tables")
}

model MenuCategory {
  id           String    @id @default(uuid())
  restaurantId String
  tenantId     String
  name         String
  description  String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("menu_categories")
}

model Product {
  id             String    @id @default(uuid())
  restaurantId   String
  tenantId       String
  menuCategoryId String?
  name           String
  description    String?
  sku            String?
  basePrice      Decimal   @db.Decimal(10, 2)
  costPrice      Decimal?  @db.Decimal(10, 2)
  taxRate        Decimal?  @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  sortOrder      Int       @default(0)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  restaurant          Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory        MenuCategory?               @relation(fields: [menuCategoryId], references: [id], onDelete: SetNull)
  station             KitchenStation?             @relation(fields: [stationId], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  images              ProductImage[]
  availability        ProductAvailability[]
  ingredients         ProductIngredient[]
  tagAssignments      ProductTagAssignment[]
  allergenAssignments ProductAllergenAssignment[]
  orderItems          OrderItem[]
  NutritionalInfo     NutritionalInfo?
  recipes             Recipe[]

  stationId String?

  @@unique([restaurantId, sku])
  @@index([deletedAt])
  @@index([isActive])
  @@index([menuCategoryId])
  @@index([restaurantId])
  @@index([stationId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("products")
}

model VariantGroup {
  id           String      @id @default(uuid())
  restaurantId String
  tenantId     String
  name         String
  description  String?
  type         VariantType @default(SINGLE)
  sortOrder    Int         @default(0)
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]

  @@unique([restaurantId, name, deletedAt])
  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("variant_groups")
}

model ProductVariant {
  id             String    @id @default(uuid())
  variantGroupId String?
  productId      String
  tenantId       String
  name           String
  sku            String?
  price          Decimal   @db.Decimal(10, 2)
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  variantGroup VariantGroup?            @relation(fields: [variantGroupId], references: [id], onDelete: SetNull)
  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers    ProductVariantModifier[]

  @@unique([variantGroupId, productId, name, deletedAt])
  @@index([deletedAt])
  @@index([productId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([variantGroupId])
  @@map("product_variants")
}

model ModifierGroup {
  id           String    @id @default(uuid())
  restaurantId String
  tenantId     String
  name         String
  description  String?
  minSelection Int       @default(0)
  maxSelection Int?
  isRequired   Boolean   @default(false)
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  modifiers  Modifier[]

  @@unique([restaurantId, name, deletedAt])
  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("modifier_groups")
}

model Modifier {
  id              String    @id @default(uuid())
  modifierGroupId String
  tenantId        String
  name            String
  price           Decimal   @db.Decimal(10, 2)
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  modifierGroup ModifierGroup            @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  variantLinks  ProductVariantModifier[]

  @@unique([modifierGroupId, name, deletedAt])
  @@index([deletedAt])
  @@index([modifierGroupId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("modifiers")
}

model ProductVariantModifier {
  id         String @id @default(uuid())
  variantId  String
  modifierId String

  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  modifier  Modifier       @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@unique([variantId, modifierId])
  @@index([variantId])
  @@index([modifierId])
  @@map("product_variant_modifiers")
}

model ProductTag {
  id           String    @id @default(uuid())
  restaurantId String
  tenantId     String
  name         String
  slug         String
  description  String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   ProductTagAssignment[]

  @@unique([restaurantId, slug, deletedAt])
  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("product_tags")
}

model Allergen {
  id           String    @id @default(uuid())
  restaurantId String
  tenantId     String
  name         String
  slug         String
  description  String?
  iconUrl      String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   ProductAllergenAssignment[]

  @@unique([restaurantId, slug, deletedAt])
  @@index([deletedAt])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("allergens")
}

model ProductTagAssignment {
  id        String @id @default(uuid())
  productId String
  tagId     String

  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       ProductTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@index([productId])
  @@index([tagId])
  @@map("product_tag_assignments")
}

model ProductAllergenAssignment {
  id         String @id @default(uuid())
  productId  String
  allergenId String

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen  Allergen  @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  @@unique([productId, allergenId])
  @@index([productId])
  @@index([allergenId])
  @@map("product_allergen_assignments")
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  tenantId  String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([tenantId])
  @@map("product_images")
}

model ProductAvailability {
  id        String    @id @default(uuid())
  productId String
  tenantId  String
  dayOfWeek DayOfWeek
  startTime String
  endTime   String

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, dayOfWeek, startTime])
  @@index([productId])
  @@index([tenantId])
  @@map("product_availability")
}

model NutritionalInfo {
  id        String    @id @default(uuid())
  productId String    @unique
  tenantId  String
  calories  Int?
  protein   Decimal?  @db.Decimal(6, 2)
  carbs     Decimal?  @db.Decimal(6, 2)
  fat       Decimal?  @db.Decimal(6, 2)
  fiber     Decimal?  @db.Decimal(6, 2)
  sugar     Decimal?  @db.Decimal(6, 2)
  sodium    Decimal?  @db.Decimal(8, 2)
  metadata  Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("nutritional_info")
}

model BusinessHours {
  id           String    @id @default(uuid())
  restaurantId String
  tenantId     String
  dayOfWeek    DayOfWeek
  openTime     String
  closeTime    String
  isClosed     Boolean   @default(false)

  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek])
  @@index([restaurantId])
  @@index([tenantId])
  @@map("business_hours")
}

model BusinessException {
  id           String    @id @default(uuid())
  restaurantId String
  tenantId     String
  date         DateTime  @db.Date
  openTime     String?
  closeTime    String?
  isClosed     Boolean   @default(true)
  reason       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("business_exceptions")
}

model Order {
  id                String        @id @default(uuid())
  orderNumber       Int
  tenantId          String
  restaurantId      String
  branchId          String
  tableId           String?
  userId            String?
  orderType         OrderType     @default(DINE_IN)
  status            OrderStatus   @default(DRAFT)
  kitchenStatus     KitchenStatus @default(PENDING)
  source            String        @default("POS")
  subtotal          Decimal       @db.Decimal(10, 2)
  discount          Decimal       @default(0) @db.Decimal(10, 2)
  discountType      DiscountType?
  discountReason    String?
  discountAmount    Decimal       @default(0) @db.Decimal(10, 2)
  serviceCharge     Decimal       @default(0) @db.Decimal(10, 2)
  serviceChargeId   String?
  serviceChargeRate Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount         Decimal       @default(0) @db.Decimal(10, 2)
  taxRateId         String?
  taxRate           Decimal       @default(0) @db.Decimal(5, 2)
  tip               Decimal       @default(0) @db.Decimal(10, 2)
  total             Decimal       @db.Decimal(10, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(10, 2)

  customerName    String?
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String?
  deliveryFee     Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  version Int @default(1)

  completedAt DateTime?
  voidedAt    DateTime?
  voidReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  restaurant       Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table            Table?               @relation(fields: [tableId], references: [id], onDelete: SetNull)
  user             User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceChargeRef ServiceCharge?       @relation("OrderServiceCharge", fields: [serviceChargeId], references: [id], onDelete: SetNull)
  taxRateRef       TaxRate?             @relation("OrderTaxRate", fields: [taxRateId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  statusHistory    OrderStatusHistory[]
  orderNotes       OrderNote[]
  kitchenTickets   KitchenTicket[]

  @@unique([restaurantId, orderNumber])
  @@index([branchId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([orderType])
  @@index([restaurantId])
  @@index([source])
  @@index([status])
  @@index([tableId])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id               String        @id @default(uuid())
  orderId          String
  tenantId         String
  productId        String
  productName      String
  variantId        String?
  variantName      String?
  sku              String?
  quantity         Int           @default(1)
  unitPrice        Decimal       @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  discountType     DiscountType?
  taxAmount        Decimal       @default(0) @db.Decimal(10, 2)
  serviceCharge    Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  kitchenStatus    KitchenStatus @default(PENDING)
  preparationNotes String?
  priceSnapshot    Json?
  taxSnapshot      Json?
  voidedAt         DateTime?
  voidReason       String?
  createdAt        DateTime      @default(now())
  deletedAt        DateTime?
  updatedAt        DateTime      @updatedAt

  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  modifiers          OrderItemModifier[]
  kitchenTicketItems KitchenTicketItem[]

  @@index([kitchenStatus])
  @@index([orderId])
  @@index([productId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("order_items")
}

model OrderItemModifier {
  id          String  @id @default(uuid())
  orderItemId String
  tenantId    String
  modifierId  String?
  name        String
  quantity    Int     @default(1)
  price       Decimal @db.Decimal(10, 2)

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([tenantId])
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  tenantId        String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedBy       String?
  changedByUserId String?
  reason          String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  deletedAt       DateTime?

  order         Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([orderId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("order_status_history")
}

model OrderNote {
  id        String    @id @default(uuid())
  orderId   String
  tenantId  String
  type      NoteType  @default(GENERAL)
  content   String
  userId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([type])
  @@map("order_notes")
}

model KitchenTicket {
  id           String        @id @default(uuid())
  orderId      String
  tenantId     String
  ticketNumber Int
  status       KitchenStatus @default(PENDING)
  priority     Int           @default(0)
  printedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime      @updatedAt

  station KitchenStation?     @relation(fields: [stationId], references: [id], onDelete: SetNull)
  order   Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items   KitchenTicketItem[]

  stationId String?

  @@unique([orderId, ticketNumber])
  @@index([createdAt])
  @@index([orderId])
  @@index([stationId])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("kitchen_tickets")
}

model Payment {
  id           String        @id @default(uuid())
  orderId      String
  tenantId     String
  method       PaymentMethod
  status       PaymentStatus @default(PENDING)
  amount       Decimal       @db.Decimal(10, 2)
  tip          Decimal       @default(0) @db.Decimal(10, 2)
  reference    String?
  gatewayRef   String?
  gatewayData  Json?
  idempotencyKey String?
  processedAt  DateTime?
  refundedAt   DateTime?
  refundReason String?
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([method])
  @@index([orderId])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@unique([tenantId, idempotencyKey])
  @@map("payments")
}

model Ingredient {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  unit        String
  costPerUnit Decimal?  @db.Decimal(10, 4)
  stockLevel  Decimal?  @db.Decimal(10, 2)
  minStock    Decimal?  @db.Decimal(10, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products        ProductIngredient[]
  inventoryItem   InventoryItem?      @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
