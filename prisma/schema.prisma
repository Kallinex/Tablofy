}

// ── SUPPLIER PERFORMANCE ──

model SupplierPerformanceMetric {
  id               String    @id @default(uuid())
  tenantId         String
  supplierId       String?
  supplierDetailId String?
  periodStart      DateTime
  periodEnd        DateTime
  leadTimeAvg      Decimal?  @db.Decimal(8, 2)
  fillRate         Decimal?  @db.Decimal(5, 2)
  deliveryAccuracy Decimal?  @db.Decimal(5, 2)
  rejectedItems    Int       @default(0)
  averageDelay     Decimal?  @db.Decimal(8, 2)
  totalOrders      Int       @default(0)
  onTimeDeliveries Int       @default(0)
  qualityScore     Decimal?  @db.Decimal(5, 2)
  costScore        Decimal?  @db.Decimal(5, 2)
  overallScore     Decimal?  @db.Decimal(5, 2)
  rank             Int?
