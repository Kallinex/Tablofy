// ============================================
// PHASE 5 MILESTONE 2 ENUMS
// ============================================

enum WarehouseType {
  CENTRAL
  BRANCH
  TRANSIT
  VIRTUAL
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum WarehouseZoneType {
  STORAGE
  PICKING
  RECEIVING
  SHIPPING
  RETURNS
  QUARANTINE
}

enum StorageBinType {
  RACK
  SHELF
  BIN
  PALLET
  DRAWER
}

enum StorageBinStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum BarcodeType {
  EAN13
  UPC
  CODE128
  QR
  DATAMATRIX
}

enum ForecastMethod {
  MOVING_AVERAGE
  LINEAR_REGRESSION
  SEASONAL
  EXPONENTIAL_SMOOTHING
}

enum ReorderStatus {
  PENDING
  APPROVED
  ORDERED
  CANCELLED
  COMPLETED
}

enum CycleCountStatus {
  SCHEDULED
  IN_PROGRESS
  BLIND
  COMPLETED
  APPROVED
  RECONCILED
}

enum CycleCountItemStatus {
  PENDING
  COUNTED
  VERIFIED
  DISCREPANCY
  RESOLVED
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
  MOVING_AVERAGE
}

enum ConsumptionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

// ============================================
// PHASE 5 MILESTONE 2 MODELS
// ============================================

// ── WAREHOUSE ──

model Warehouse {
  id           String          @id @default(uuid())
  tenantId     String
  name         String
  code         String
  type         WarehouseType   @default(BRANCH)
  status       WarehouseStatus @default(ACTIVE)
  address      String?
  city         String?
  country      String?
  capacity     Decimal?        @db.Decimal(12, 4)
  capacityUnit String?
  managerName  String?
  managerId    String?
  isDefault    Boolean         @default(false)
  branchId     String?
  metadata     Json?
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  zones    WarehouseZone[]
  bins     StorageBin[]
  branches WarehouseBranch[]

  @@unique([tenantId, code, deletedAt])
  @@index([branchId])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([type])
  @@map("warehouses")
}

// ── WAREHOUSE ZONE ──

model WarehouseZone {
  id           String            @id @default(uuid())
  warehouseId  String
  tenantId     String
  name         String
  code         String
  type         WarehouseZoneType @default(STORAGE)
  capacity     Decimal?          @db.Decimal(12, 4)
  capacityUnit String?
  isActive     Boolean           @default(true)
  sortOrder    Int               @default(0)
  metadata     Json?
  version      Int               @default(1)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins      StorageBin[]

  @@unique([warehouseId, code, deletedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([type])
  @@index([warehouseId])
  @@map("warehouse_zones")
}

// ── STORAGE BIN ──

model StorageBin {
  id           String           @id @default(uuid())
  zoneId       String?
  warehouseId  String
  tenantId     String
  name         String
  code         String
  type         StorageBinType   @default(BIN)
  status       StorageBinStatus @default(AVAILABLE)
  capacity     Decimal?         @db.Decimal(12, 4)
  capacityUnit String?
  currentLoad  Decimal?         @default(0) @db.Decimal(12, 4)
  maxWeight    Decimal?         @db.Decimal(12, 4)
  length       Decimal?         @db.Decimal(12, 4)
  width        Decimal?         @db.Decimal(12, 4)
  height       Decimal?         @db.Decimal(12, 4)
  isActive     Boolean          @default(true)
  metadata     Json?
  version      Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  zone      WarehouseZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code, deletedAt])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([type])
  @@index([warehouseId])
  @@index([zoneId])
  @@map("storage_bins")
}

// ── WAREHOUSE-BRANCH MAPPING ──

model WarehouseBranch {
  id          String    @id @default(uuid())
  warehouseId String
  branchId    String
  tenantId    String
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, branchId])
  @@index([branchId])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("warehouse_branches")
}

// ── BARCODE / QR ──

model Barcode {
  id              String      @id @default(uuid())
  inventoryItemId String
  tenantId        String
  barcode         String?
  qrCode          String?
  type            BarcodeType @default(CODE128)
  isPrimary       Boolean     @default(false)
  labelTemplate   String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  deletedAt       DateTime?
  updatedAt       DateTime    @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([barcode, tenantId])
  @@unique([qrCode, tenantId])
  @@index([inventoryItemId])
  @@index([isPrimary])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("barcodes")
}

// ── INVENTORY FORECAST ──

model InventoryForecast {
  id              String            @id @default(uuid())
  inventoryItemId String
  tenantId        String
  forecastDate    DateTime
  quantity        Decimal           @db.Decimal(12, 4)
  confidence      Decimal?          @db.Decimal(5, 4)
  method          ForecastMethod    @default(MOVING_AVERAGE)
  period          ConsumptionPeriod @default(DAILY)
  factors         Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([forecastDate])
  @@index([inventoryItemId])
  @@index([method])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("inventory_forecasts")
}

// ── REORDER SUGGESTION ──

model ReorderSuggestion {
  id                String        @id @default(uuid())
  inventoryItemId   String
  tenantId          String
  warehouseId       String?
  suggestedQuantity Decimal       @db.Decimal(12, 4)
  suggestedDate     DateTime
  currentStock      Decimal       @db.Decimal(12, 4)
  minStock          Decimal?      @db.Decimal(12, 4)
  maxStock          Decimal?      @db.Decimal(12, 4)
  safetyStock       Decimal?      @db.Decimal(12, 4)
  leadTimeDays      Int           @default(1)
  eoq               Decimal?      @db.Decimal(12, 4)
  priority          String?
  status            ReorderStatus @default(PENDING)
  approvedById      String?
  approvedAt        DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  deletedAt         DateTime?
  updatedAt         DateTime      @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([status])
  @@index([suggestedDate])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("reorder_suggestions")
}

// ── CONSUMPTION RECORD ──

model ConsumptionRecord {
  id              String            @id @default(uuid())
  inventoryItemId String
  tenantId        String
