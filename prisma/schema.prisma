  unitId         String?
  locationId     String?
  currentQuantity Decimal  @default(0) @db.Decimal(12, 4)
  reservedQuantity Decimal @default(0) @db.Decimal(12, 4)
  availableQuantity Decimal @default(0) @db.Decimal(12, 4)
  minStock       Decimal?  @db.Decimal(12, 4)
  maxStock       Decimal?  @db.Decimal(12, 4)
  reorderLevel   Decimal?  @db.Decimal(12, 4)
  unitCost       Decimal?  @db.Decimal(12, 4)
  averageCost    Decimal?  @db.Decimal(12, 4)
  lastCost       Decimal?  @db.Decimal(12, 4)
  isActive       Boolean   @default(true)
  isPurchasable  Boolean   @default(true)
  isManufactured Boolean   @default(false)
