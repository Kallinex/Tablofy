  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  inventoryItem   InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([goodsReceiptId])
  @@index([purchaseOrderItemId])
  @@index([inventoryItemId])
  @@index([tenantId])
  @@map("goods_receipt_items")
}

// ── STOCK MOVEMENT ──

model StockMovement {
  id               String            @id @default(uuid())
  inventoryItemId  String
  tenantId         String
  branchId         String?
  type             StockMovementType
  quantity         Decimal           @db.Decimal(12, 4)
  unitCost         Decimal?          @db.Decimal(12, 4)
  totalCost        Decimal?          @db.Decimal(12, 4)
  referenceType    String?
  referenceId      String?
  batchNumber      String?
  lotNumber        String?
  notes            String?
  recordedById     String?
  createdAt        DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

// ── BRANCH TRANSFER ──

model BranchTransfer {
  id              String         @id @default(uuid())
  transferNumber  String
  tenantId        String
  fromBranchId    String
  toBranchId      String
  status          TransferStatus @default(DRAFT)
  requestedById   String?
  approvedById    String?
  approvedAt      DateTime?
  receivedById    String?
  receivedAt      DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  cancelReason    String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  fromBranch Branch @relation("TransferFromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch   Branch @relation("TransferToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  items      BranchTransferItem[]

  @@unique([tenantId, transferNumber, deletedAt])
  @@index([tenantId])
  @@index([fromBranchId])
  @@index([toBranchId])
  @@index([status])
  @@index([deletedAt])
  @@map("branch_transfers")
}

// ── BRANCH TRANSFER ITEM ──

model BranchTransferItem {
  id                String   @id @default(uuid())
  branchTransferId  String
  inventoryItemId   String?
  tenantId          String
  quantity          Decimal  @db.Decimal(12, 4)
  receivedQuantity  Decimal  @default(0) @db.Decimal(12, 4)
  unitCost          Decimal? @db.Decimal(12, 4)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branchTransfer BranchTransfer @relation(fields: [branchTransferId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([branchTransferId])
  @@index([inventoryItemId])
  @@index([tenantId])
  @@map("branch_transfer_items")
}

// ── RECIPE ──

model Recipe {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  description        String?
  productId          String?
  yield              Decimal? @db.Decimal(10, 2)
  servingUnit        String?
  preparationTime    Int?
  cookingTime        Int?
  instructions       String?
  version            Int      @default(1)
  cost               Decimal? @db.Decimal(12, 4)
  foodCostPercentage Decimal? @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  deletedAt          DateTime?

  product Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  items   RecipeItem[]

  @@unique([tenantId, name, deletedAt])
  @@index([tenantId])
  @@index([productId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("recipes")
}

// ── RECIPE ITEM ──

model RecipeItem {
  id              String  @id @default(uuid())
  recipeId        String
  inventoryItemId String?
  tenantId        String
  quantity        Decimal @db.Decimal(12, 4)
  unit            String?
  wastePercentage Decimal? @db.Decimal(5, 2)
  notes           String?
  sortOrder       Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  recipe        Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  @@index([recipeId])
  @@index([inventoryItemId])
  @@index([tenantId])
  @@map("recipe_items")
}

// ── STOCK ADJUSTMENT ──

model StockAdjustment {
