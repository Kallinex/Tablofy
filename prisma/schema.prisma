  @@index([deletedAt])
  @@index([isActive])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("ingredients")
}

model Supplier {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  isActive    Boolean   @default(true)
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  products           ProductIngredient[]
  detail             SupplierDetail?
  performanceMetrics SupplierPerformanceMetric[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("suppliers")
}

model ProductIngredient {
  id           String  @id @default(uuid())
  productId    String
  ingredientId String
  supplierId   String?
  tenantId     String
  quantity     Decimal @db.Decimal(10, 4)

  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([productId, ingredientId])
  @@index([productId])
  @@index([ingredientId])
  @@index([supplierId])
  @@index([tenantId])
  @@map("product_ingredients")
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isRead])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([userId])
  @@map("notifications")
}

model Message {
  id          String    @id @default(uuid())
  tenantId    String
  senderId    String
  recipientId String
  subject     String?
  body        String
  isRead      Boolean   @default(false)
  sentAt      DateTime  @default(now())
  readAt      DateTime?

  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  sender    User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([senderId])
  @@index([recipientId])
  @@index([isRead])
  @@index([sentAt])
  @@map("messages")
}

model Report {
  id          String       @id @default(uuid())
  tenantId    String
  userId      String?
  type        ReportType
  title       String
  description String?
  parameters  Json?
  result      Json?
  status      ReportStatus @default(PENDING)
  generatedAt DateTime?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?
  updatedAt   DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@index([type])
  @@index([userId])
  @@map("reports")
}

model Feedback {
