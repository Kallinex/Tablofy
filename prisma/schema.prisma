enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum RewardType {
  COUPON
  DISCOUNT
  FREE_PRODUCT
  FREE_DRINK
  BIRTHDAY
  ANNIVERSARY
  REFERRAL
  PROMOTIONAL
}

enum RewardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum WalletTransactionType {
  RECHARGE
  SPEND
  REFUND
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum ReferralStatus {
  PENDING
  REWARDED
  EXPIRED
}

enum SegmentType {
  VIP
  INACTIVE
  HIGH_SPENDER
  FREQUENT_VISITOR
  NEW_CUSTOMER
  LOST_CUSTOMER
  CUSTOM
}

