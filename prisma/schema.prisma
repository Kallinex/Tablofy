  redeemedAt     DateTime?
  metadata       Json              @default("{}")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions GiftCardTransaction[]
