  @@index([code])
  @@index([expiresAt])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id            String                  @id @default(uuid())
