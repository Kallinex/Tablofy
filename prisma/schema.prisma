  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([date])
  @@index([inventoryItemId])
  @@index([period])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@map("consumption_records")
}

// ── CYCLE COUNT ──

model CycleCount {
  id            String           @id @default(uuid())
  tenantId      String
  warehouseId   String?
  countDate     DateTime
  scheduledDate DateTime?
  status        CycleCountStatus @default(SCHEDULED)
  countType     CycleCountType   @default(FULL)
  notes         String?
  approvedById  String?
  approvedAt    DateTime?
  finalizedById String?
  finalizedAt   DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  items CycleCountItem[]

  @@index([countDate])
  @@index([status])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId])
  @@index([warehouseId])
  @@map("cycle_counts")
}

model CycleCountItem {
  id               String               @id @default(uuid())
  cycleCountId     String
  inventoryItemId  String
  expectedQuantity Decimal              @db.Decimal(12, 4)
  actualQuantity   Decimal?             @db.Decimal(12, 4)
  variance         Decimal?             @db.Decimal(12, 4)
  variancePercent  Decimal?             @db.Decimal(5, 2)
  isBlind          Boolean              @default(false)
  status           CycleCountItemStatus @default(PENDING)
  notes            String?
  countedById      String?
  countedAt        DateTime?
  verifiedById     String?
  verifiedAt       DateTime?
