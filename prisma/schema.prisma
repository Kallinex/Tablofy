enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum MembershipTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum RewardType {
  COUPON
  DISCOUNT
  FREE_PRODUCT
  FREE_DRINK
  BIRTHDAY
  ANNIVERSARY
  REFERRAL
  PROMOTIONAL
}

enum RewardStatus {
  ACTIVE
  REDEEMED
  EXPIRED
  CANCELLED
}

enum WalletTransactionType {
  RECHARGE
  SPEND
  REFUND
  ADJUSTMENT
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
}

enum ReferralStatus {
  PENDING
  REWARDED
  EXPIRED
}

enum SegmentType {
  VIP
  INACTIVE
  HIGH_SPENDER
  FREQUENT_VISITOR
  NEW_CUSTOMER
  LOST_CUSTOMER
  CUSTOM
}

// ============================================
// MODELS (Phase 4 M1 — 17 new)
// ============================================

model Customer {
  id                String         @id @default(uuid())
  tenantId          String
  restaurantId      String?
  email             String?
  phone             String?
  firstName         String
  lastName          String
  avatarUrl         String?
  gender            String?
  dateOfBirth       DateTime?
  anniversary       DateTime?
  language          String         @default("en")
  notes             String?
  status            CustomerStatus @default(ACTIVE)
  preferredBranchId String?
  preferredTableId  String?
  tags              String[]
  source            String?
  metadata          Json?
  version           Int            @default(1)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  tenant            Tenant                      @relation(fields: [tenantId], references: [id])
  restaurant        Restaurant?                 @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  addresses         CustomerAddress[]
  preferences       CustomerPreference[]
  visitHistory      VisitHistory[]
  loyaltyTransactions LoyaltyPointsTransaction[]
  memberships       Membership[]
  rewards           Reward[]
  wallets           Wallet[]
  referralsMade     Referral[]                  @relation("ReferralMade")
  referralsUsed     Referral[]                  @relation("ReferralUsed")
  segmentAssignments CustomerSegmentAssignment[]
  analytics         CustomerAnalytics?

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([tenantId, restaurantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  tenantId   String
  label      String?
  address    String
  city       String?
  state      String?
  zipCode    String?
  country    String?
  isDefault  Boolean  @default(false)
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tenantId])
  @@map("customer_addresses")
}

model CustomerPreference {
  id         String   @id @default(uuid())
  customerId String
  tenantId   String
  key        String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([tenantId])
  @@map("customer_preferences")
}

model VisitHistory {
  id         String     @id @default(uuid())
