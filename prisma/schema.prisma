  @@unique([restaurantId, orderNumber])
  @@index([tenantId])
  @@index([restaurantId])
  @@index([branchId])
  @@index([tableId])
  @@index([userId])
  @@index([status])
  @@index([orderType])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("orders")
