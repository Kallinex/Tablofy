  notes           String?
  recordedById    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("waste_entries")
}

// ── INVENTORY COUNT ──

model InventoryCount {
  id               String    @id @default(uuid())
  inventoryItemId  String
  tenantId         String
  branchId         String?
  countType        CountType
  expectedQuantity Decimal   @db.Decimal(12, 4)
  actualQuantity   Decimal   @db.Decimal(12, 4)
  variance         Decimal   @db.Decimal(12, 4)
  unitCost         Decimal?  @db.Decimal(12, 4)
  varianceCost     Decimal?  @db.Decimal(12, 4)
  notes            String?
  countedById      String?
  countedAt        DateTime  @default(now())
  status           String    @default("PENDING")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([branchId])
  @@index([countType])
  @@index([countedAt])
  @@map("inventory_counts")
}

// ── EXPIRATION ALERT ──

model ExpirationAlert {
  id              String    @id @default(uuid())
  inventoryItemId String
  tenantId        String
  batchNumber     String?
  expiryDate      DateTime
  alertType       String    @default("WARNING")
  message         String?
  sentAt          DateTime  @default(now())
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([expiryDate])
  @@index([alertType])
  @@index([resolvedAt])
  @@map("expiration_alerts")
}

// ============================================
// PHASE 5 MILESTONE 2 ENUMS
// ============================================

enum WarehouseType {
  CENTRAL
  BRANCH
  TRANSIT
  VIRTUAL
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum WarehouseZoneType {
  STORAGE
  PICKING
  RECEIVING
  SHIPPING
  RETURNS
  QUARANTINE
}

enum StorageBinType {
  RACK
  SHELF
  BIN
  PALLET
  DRAWER
}

enum StorageBinStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum BarcodeType {
  EAN13
  UPC
  CODE128
  QR
  DATAMATRIX
}

enum ForecastMethod {
  MOVING_AVERAGE
  LINEAR_REGRESSION
  SEASONAL
  EXPONENTIAL_SMOOTHING
}

enum ReorderStatus {
  PENDING
  APPROVED
  ORDERED
  CANCELLED
  COMPLETED
}

enum CycleCountStatus {
  SCHEDULED
  IN_PROGRESS
  BLIND
  COMPLETED
  APPROVED
  RECONCILED
}

enum CycleCountItemStatus {
  PENDING
  COUNTED
  VERIFIED
  DISCREPANCY
  RESOLVED
}

enum ValuationMethod {
  FIFO
  WEIGHTED_AVERAGE
  MOVING_AVERAGE
}

enum ConsumptionPeriod {
  DAILY
  WEEKLY
  MONTHLY
}

// ============================================
// PHASE 5 MILESTONE 2 MODELS
// ============================================

// ── WAREHOUSE ──

model Warehouse {
  id            String          @id @default(uuid())
  tenantId      String
  name          String
  code          String
  type          WarehouseType   @default(BRANCH)
  status        WarehouseStatus @default(ACTIVE)
  address       String?
  city          String?
  country       String?
  capacity      Decimal?        @db.Decimal(12, 4)
  capacityUnit  String?
  managerName   String?
  managerId     String?
  isDefault     Boolean         @default(false)
  branchId      String?
  metadata      Json?
  version       Int             @default(1)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?

  zones     WarehouseZone[]
  bins      StorageBin[]
  branches  WarehouseBranch[]

  @@unique([tenantId, code, deletedAt])
  @@index([tenantId])
  @@index([branchId])
  @@index([type])
  @@index([status])
  @@map("warehouses")
}

// ── WAREHOUSE ZONE ──

model WarehouseZone {
  id          String            @id @default(uuid())
  warehouseId String
  tenantId    String
  name        String
  code        String
  type        WarehouseZoneType @default(STORAGE)
  capacity    Decimal?          @db.Decimal(12, 4)
  capacityUnit String?
  isActive    Boolean           @default(true)
  sortOrder   Int               @default(0)
  metadata    Json?
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  warehouse Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  bins      StorageBin[]

  @@unique([warehouseId, code, deletedAt])
  @@index([tenantId])
  @@index([warehouseId])
  @@index([type])
  @@map("warehouse_zones")
}

// ── STORAGE BIN ──

model StorageBin {
  id           String           @id @default(uuid())
  zoneId       String?
  warehouseId  String
  tenantId     String
  name         String
  code         String
  type         StorageBinType   @default(BIN)
  status       StorageBinStatus @default(AVAILABLE)
  capacity     Decimal?         @db.Decimal(12, 4)
  capacityUnit String?
  currentLoad  Decimal?         @default(0) @db.Decimal(12, 4)
  maxWeight    Decimal?         @db.Decimal(12, 4)
  length       Decimal?         @db.Decimal(12, 4)
  width        Decimal?         @db.Decimal(12, 4)
  height       Decimal?         @db.Decimal(12, 4)
  isActive     Boolean          @default(true)
  metadata     Json?
  version      Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?

  zone      WarehouseZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, code, deletedAt])
  @@index([tenantId])
  @@index([zoneId])
  @@index([warehouseId])
  @@index([type])
  @@index([status])
  @@map("storage_bins")
}

// ── WAREHOUSE-BRANCH MAPPING ──

model WarehouseBranch {
  id          String   @id @default(uuid())
  warehouseId String
  branchId    String
  tenantId    String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, branchId])
  @@index([tenantId])
  @@index([branchId])
  @@map("warehouse_branches")
}

// ── BARCODE / QR ──

model Barcode {
  id              String     @id @default(uuid())
  inventoryItemId String
  tenantId        String
  barcode         String?
  qrCode          String?
  type            BarcodeType @default(CODE128)
  isPrimary       Boolean     @default(false)
  labelTemplate   String?
  metadata        Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([barcode, tenantId])
  @@unique([qrCode, tenantId])
  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([isPrimary])
  @@map("barcodes")
}

// ── INVENTORY FORECAST ──

model InventoryForecast {
  id              String          @id @default(uuid())
  inventoryItemId String
  tenantId        String
  forecastDate    DateTime
  quantity        Decimal         @db.Decimal(12, 4)
  confidence      Decimal?        @db.Decimal(5, 4)
  method          ForecastMethod  @default(MOVING_AVERAGE)
  period          ConsumptionPeriod @default(DAILY)
  factors         Json?
  createdAt       DateTime        @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([forecastDate])
  @@index([method])
  @@map("inventory_forecasts")
}

// ── REORDER SUGGESTION ──

model ReorderSuggestion {
  id              String        @id @default(uuid())
  inventoryItemId String
  tenantId        String
  warehouseId     String?
  suggestedQuantity Decimal     @db.Decimal(12, 4)
  suggestedDate   DateTime
  currentStock    Decimal       @db.Decimal(12, 4)
  minStock        Decimal?      @db.Decimal(12, 4)
  maxStock        Decimal?      @db.Decimal(12, 4)
  safetyStock     Decimal?      @db.Decimal(12, 4)
  leadTimeDays    Int           @default(1)
  eoq             Decimal?      @db.Decimal(12, 4)
  priority        String?
  status          ReorderStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([status])
  @@index([suggestedDate])
  @@map("reorder_suggestions")
}

// ── CONSUMPTION RECORD ──

model ConsumptionRecord {
  id              String           @id @default(uuid())
  inventoryItemId String
  tenantId        String
  date            DateTime
  quantity        Decimal          @db.Decimal(12, 4)
  unitCost        Decimal?         @db.Decimal(12, 4)
  totalCost       Decimal?         @db.Decimal(12, 4)
  period          ConsumptionPeriod @default(DAILY)
  source          String?
  referenceId     String?
  createdAt       DateTime         @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
  @@index([date])
  @@index([period])
  @@map("consumption_records")
}

// ── CYCLE COUNT ──

model CycleCount {
  id            String           @id @default(uuid())
  tenantId      String
  warehouseId   String?
  countDate     DateTime
  scheduledDate DateTime?
  status        CycleCountStatus @default(SCHEDULED)
  countType     String           @default("FULL")
  notes         String?
  approvedById  String?
  approvedAt    DateTime?
  finalizedById String?
  finalizedAt   DateTime?
  metadata      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  deletedAt     DateTime?

  items CycleCountItem[]

  @@index([tenantId])
  @@index([warehouseId])
  @@index([status])
  @@index([countDate])
  @@map("cycle_counts")
}

model CycleCountItem {
  id               String               @id @default(uuid())
  cycleCountId     String
  inventoryItemId  String
  expectedQuantity Decimal              @db.Decimal(12, 4)
  actualQuantity   Decimal?             @db.Decimal(12, 4)
  variance         Decimal?             @db.Decimal(12, 4)
  variancePercent  Decimal?             @db.Decimal(5, 2)
  isBlind          Boolean              @default(false)
  status           CycleCountItemStatus @default(PENDING)
  notes            String?
  countedById      String?
  countedAt        DateTime?
  verifiedById     String?
  verifiedAt       DateTime?
  metadata         Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  cycleCount     CycleCount     @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([cycleCountId, inventoryItemId])
  @@index([cycleCountId])
  @@index([inventoryItemId])
  @@index([status])
  @@map("cycle_count_items")
}

// ── SUPPLIER PERFORMANCE ──

model SupplierPerformanceMetric {
  id              String   @id @default(uuid())
  tenantId        String
  supplierId      String?
  supplierDetailId String?
  periodStart     DateTime
  periodEnd       DateTime
  leadTimeAvg     Decimal? @db.Decimal(8, 2)
  fillRate        Decimal? @db.Decimal(5, 2)
  deliveryAccuracy Decimal? @db.Decimal(5, 2)
  rejectedItems   Int      @default(0)
  averageDelay    Decimal? @db.Decimal(8, 2)
  totalOrders     Int      @default(0)
  onTimeDeliveries Int     @default(0)
  qualityScore    Decimal? @db.Decimal(5, 2)
  costScore       Decimal? @db.Decimal(5, 2)
  overallScore    Decimal? @db.Decimal(5, 2)
  rank            Int?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierDetail SupplierDetail? @relation(fields: [supplierDetailId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([supplierId])
  @@index([supplierDetailId])
  @@index([periodStart, periodEnd])
  @@index([overallScore])
  @@map("supplier_performance_metrics")
}

// ── INVENTORY VALUATION ──

model InventoryValuation {
  id              String         @id @default(uuid())
  inventoryItemId String
  tenantId        String
  valuationDate   DateTime
  method          ValuationMethod @default(WEIGHTED_AVERAGE)
  unitCost        Decimal        @db.Decimal(12, 4)
  totalValue      Decimal        @db.Decimal(16, 4)
  quantity        Decimal        @db.Decimal(12, 4)
  currency        Currency       @default(USD)
  metadata        Json?
  createdAt       DateTime       @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([tenantId])
   @@index([valuationDate])
   @@index([method])
   @@map("inventory_valuations")
}

model ScheduledReport {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  type        String
  format      String
  schedule    String
  recipients  Json      @default("[]")
  config      Json      @default("{}")
  isActive    Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@map("scheduled_reports")
}

model ReportExport {
  id            String    @id @default(uuid())
  tenantId      String
  type          String
  reportType    String
  periodStart   DateTime?
  periodEnd     DateTime?
  config        Json      @default("{}")
  filePath      String?
  fileSize      Int?
  status        String    @default("PENDING")
  errorMessage  String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  deletedAt     DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("report_exports")
}

model AnalyticsDashboard {
  id          String    @id @default(uuid())
  tenantId    String
  name        String    @default("Default")
  config      Json      @default("{}")
  layout      Json      @default("{}")
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("analytics_dashboards")
}

model WebhookRegistration {
  id              String          @id @default(uuid())
  tenantId        String
  name            String
  url             String
  description     String?
  events          String[]
  secretHash      String
  secretPrefix    String
  encryptedSecret String?
  isActive        Boolean         @default(true)
  retryCount      Int             @default(3)
  timeoutMs       Int             @default(30000)
  headers         Json            @default("{}")
  metadata        Json            @default("{}")
  lastDeliveredAt DateTime?
  lastFailureAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  deliveries      WebhookDelivery[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("webhook_registrations")
}

model WebhookDelivery {
  id              String              @id @default(uuid())
  webhookId       String
  tenantId        String
  eventType       String
  eventId         String
  payload         Json
  status          String              @default("PENDING")
  attemptCount    Int                 @default(0)
  maxRetries      Int                 @default(3)
  statusCode      Int?
  responseBody    String?
  durationMs      Int?
  errorMessage    String?
  nextRetryAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  registration    WebhookRegistration @relation(fields: [webhookId], references: [id])

  @@index([webhookId])
  @@index([tenantId, status])
  @@index([eventType])
  @@index([nextRetryAt])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

model ApiKey {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  keyPrefix       String
  keyHash         String
  keyLastChars    String
  scopes          String[]
  isActive        Boolean   @default(true)
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  rateLimitPerMin Int       @default(60)
  metadata        Json      @default("{}")
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  createdBy       User      @relation(fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([keyPrefix])
  @@unique([tenantId, name])
  @@map("api_keys")
}

model GiftCard {
  id              String               @id @default(uuid())
  tenantId        String
  code            String               @unique
  initialBalance  Decimal              @default(0)
  currentBalance  Decimal              @default(0)
  currency        Currency             @default(USD)
  status          String               @default("ACTIVE")
  issueType       String               @default("MANUAL")
  recipientName   String?
  recipientEmail  String?
  recipientPhone  String?
  message         String?
  expiresAt       DateTime?
  issuedById      String?
  issuedAt        DateTime             @default(now())
  redeemedAt      DateTime?
  metadata        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  transactions    GiftCardTransaction[]
  issuedBy        User?                @relation("IssuedGiftCards", fields: [issuedById], references: [id])

  @@index([tenantId])
  @@index([code])
  @@index([status])
  @@index([expiresAt])
  @@map("gift_cards")
}

model GiftCardTransaction {
  id            String    @id @default(uuid())
  giftCardId    String
  tenantId      String
  type          String
  amount        Decimal   @default(0)
  balanceBefore Decimal   @default(0)
  balanceAfter  Decimal   @default(0)
  currency      Currency  @default(USD)
  referenceId   String?
  referenceType String?
  description   String?
  performedById String?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  giftCard      GiftCard  @relation(fields: [giftCardId], references: [id])
  performedBy   User?     @relation("PerformedTransactions", fields: [performedById], references: [id])

  @@index([giftCardId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
  @@map("gift_card_transactions")
}

model ConsentRecord {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String?
  customerId  String?
  type        String
  granted     Boolean   @default(false)
  ipAddress   String?
  userAgent   String?
  consentDate DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User?     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([customerId])
  @@index([type])
  @@index([consentDate])
  @@map("consent_records")
}

model CookiePreference {
  id              String   @id @default(uuid())
  tenantId        String
  userId          String?
  visitorId       String?
  necessary       Boolean  @default(true)
  functional      Boolean  @default(true)
  analytics       Boolean  @default(false)
  marketing       Boolean  @default(false)
  thirdParty      Boolean  @default(false)
  ipAddress       String?
  userAgent       String?
  preferencesSet  DateTime @default(now())
  lastUpdated     DateTime @updatedAt
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([visitorId])
  @@map("cookie_preferences")
}

model DataExportRequest {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  status      String    @default("PENDING")
  requestType String    @default("FULL")
  format      String    @default("JSON")
  filePath    String?
  fileSize    Int?
  expiresAt   DateTime?
  completedAt DateTime?
  errorMessage String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("data_export_requests")
}

model BackupRecord {
  id              String   @id @default(uuid())
  tenantId        String
  type            String   @default("FULL")
  status          String   @default("PENDING")
  filePath        String?
  fileSize        Int?
  checksum        String?
  metadata        Json     @default("{}")
  retentionDays   Int      @default(30)
  expiresAt       DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  errorMessage    String?
  verifiedAt      DateTime?
  verifiedBy      String?
  verificationStatus String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("backup_records")
}

model RevokedToken {
  id        String   @id @default(uuid())
  jti       String   @unique
  tenantId  String?
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([jti])
  @@index([expiresAt])
  @@map("revoked_tokens")
}
