    "prisma:seed": "node prisma/scripts/assert-safe-db.js seed && npx prisma db seed",
    "prisma:status": "node prisma/scripts/assert-safe-db.js report && npx prisma migrate status",
    "test": "nx test api",
    "test:coverage": "nx test api --configuration=coverage",
    "test:watch": "nx test api --configuration=watch",
    "lint": "nx run-many -t lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
