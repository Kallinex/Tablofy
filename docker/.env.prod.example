# ============================================================================
# Tablofy API - PRODUCTION environment file for docker/docker-compose.prod.yml
# ============================================================================
# Copy to docker/.env and replace every CHANGE_ME_* value before deploying:
#   cp docker/.env.prod.example docker/.env
#
# Run the stack with an explicit env file:
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env up -d
#
# Generate strong secrets (Linux/macOS):
#   openssl rand -hex 32
# (Windows PowerShell):
#   [Convert]::ToHexString((1..32 | % { Get-Random -Max 256 })).ToLower()
#
# NEVER commit docker/.env. It is git-ignored.
# ============================================================================

# ---- Core ----
NODE_ENV=production
PORT=3000
API_PREFIX=api
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Reverse-proxy hops to trust for X-Forwarded-For (1 = single nginx/ALB hop).
TRUST_PROXY=1

# Absolute RSS ceiling (MB) for the memory health indicator. Size to the
# container memory limit (compose default is 512MB per api replica).
HEALTH_MEMORY_RSS_LIMIT_MB=512

# ---- Database (PostgreSQL) ----
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# When using a managed database instead of the bundled container, set
# DATABASE_URL and remove/ignore the postgres service.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/tablofy_prod?schema=public&sslmode=require

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
# Enable for managed Redis over TLS (rediss://).
REDIS_TLS=false

# ---- JWT (min 32 chars each) ----
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_EXPIRATION=7d

# ---- Metrics (REQUIRED, min 16 chars) ----
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME_METRICS_AUTH_TOKEN_16CHARS

# ---- Webhooks (REQUIRED, min 32 chars) ----
WEBHOOK_ENCRYPTION_KEY=CHANGE_ME_WEBHOOK_ENCRYPTION_KEY_32CHARS

# ---- Email / SMTP (REQUIRED in production) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME_SMTP_USER
SMTP_PASS=CHANGE_ME_SMTP_PASS
SMTP_FROM=no-reply@example.com

# ---- Payments (PAYMENTS_MODE defaults to "live" in production) ----
# Leave both gateways empty ONLY if payments are not used; otherwise live mode
# refuses to boot without a fully configured gateway.
PAYMENTS_MODE=live
#
# Stripe (sk_live_* key AND webhook secret are BOTH required when configured):
# STRIPE_SECRET_KEY=sk_live_CHANGE_ME
# STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
#
# Paymob (positive integration id AND webhook secret are BOTH required when configured):
# PAYMOB_API_KEY=CHANGE_ME
# PAYMOB_INTEGRATION_ID=123456
# PAYMOB_WEBHOOK_SECRET=CHANGE_ME

# ---- Swagger (off by default; if on, Basic auth credentials are REQUIRED) ----
SWAGGER_ENABLED=false
# SWAGGER_AUTH_USER=docs
# SWAGGER_AUTH_PASSWORD=CHANGE_ME_SWAGGER_PASSWORD

# ---- Compression ----
COMPRESSION_ENABLED=true
COMPRESSION_THRESHOLD_BYTES=1024

# ---- Reverse proxy / TLS (nginx) ----
# Domain(s) served by the bundled nginx reverse proxy.
SERVER_NAME=api.example.com
# Host path to the TLS certificate/key (e.g. from certbot). Defaults to
# docker/nginx/certs; mount your real certs there or override these paths.
TLS_CERT_PATH=./nginx/certs/fullchain.pem
TLS_KEY_PATH=./nginx/certs/privkey.pem

# ---- Offsite backups ----
# Nightly pg_dump is uploaded offsite with rclone. Configure a remote first:
#   rclone config   (create a remote named "offsite", e.g. s3 / b2 / gdrive)
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
RCLONE_REMOTE=offsite
RCLONE_PATH=tablofy/backups
RCLONE_CONFIG=/config/rclone/rclone.conf
